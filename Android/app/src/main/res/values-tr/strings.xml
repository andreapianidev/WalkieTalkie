    <string name="ob_p2_title">Tek bir Wi-Fi, hesap yok</string>
    <string name="ob_p2_body">Talky diğer Talky cihazlarını kendi bulur — Android, iPhone, iPad, Mac. Sunucu yok, kayıt yok, telefon numarası yok.</string>
